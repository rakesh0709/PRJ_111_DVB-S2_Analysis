# ==============================================================================
# PRJ_111 - .gitignore
# Development of a Software Application for Analysis and Processing of DVB-S2 Receiver Output Stream
# ==============================================================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Build, Packaging & Distribution Artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js & Next.js Web Workstation
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
05_CODE/web/node_modules/
05_CODE/web/.next/
05_CODE/web/out/
05_CODE/web/.turbo/

# Testing & Code Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints

# Processed / Feature Cache Data (Generated locally during execution)
02_PROCESSED_DATA/*
!02_PROCESSED_DATA/README.md
!02_PROCESSED_DATA/.gitkeep

03_FEATURE_DATA/*
!03_FEATURE_DATA/README.md
!03_FEATURE_DATA/.gitkeep

04_AI_MODELS/*
!04_AI_MODELS/README.md
!04_AI_MODELS/.gitkeep

# 06_RESULTS are explicitly tracked analysis reports and outcomes
!06_RESULTS/
!06_RESULTS/**

# ------------------------------------------------------------------------------
# Explicitly Tracked Documentation & Media Assets (DO NOT IGNORE)
# ------------------------------------------------------------------------------
!07_DOCUMENTATION/
!07_DOCUMENTATION/*

# ==============================================================================
# PRJ_111 - Large Raw DVB-S2 Dataset Files
# Keep large raw datasets locally; do not commit them to GitHub
# ==============================================================================

# Scoped raw transport stream datasets
01_RAW_DATA/**/*.ts

# Packet Capture files
*.pcap
*.pcapng

# Dataset archives
*.zip
*.7z
*.rar

# Raw / binary dataset files
*.raw
*.bin

# Explicitly ensure Next.js TypeScript sources and test inputs are never ignored
!*.tsx
!05_CODE/test_inputs/corrupted_sample.ts

# Temporary files
*.tmp
*.temp

# =============================================================================
# Repository Reorganization Ignore Rules
# =============================================================================
07_DOCUMENTATION/RESEARCH_PAPER/build_cache/
05_CODE/uploads/*
!05_CODE/uploads/.gitkeep
~$*.docx
~$*.pptx
*_prompt.txt
final_audit_prompt.txt
latest_user_prompt.txt
